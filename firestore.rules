rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles & Addresses (Farmers & Buyers)
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if !isAuthenticated() || isOwner(userId);

      match /addresses/{addressId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Role-specific accounts
    match /farmers/{farmerId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if !isAuthenticated() || isOwner(farmerId);
    }

    match /buyers/{buyerId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if !isAuthenticated() || isOwner(buyerId);
    }

    // 2. Agricultural Products (Public marketplace read; owner farmer creates/edits/deletes)
    match /products/{productId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if !isAuthenticated() ||
                            request.auth.uid == resource.data.farmerId ||
                            request.auth.uid == request.resource.data.farmerId;
    }

    // 3. Cattle & Livestock Listings (Public marketplace read; owner farmer creates/edits/deletes)
    match /cattleListings/{listingId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if !isAuthenticated() ||
                            request.auth.uid == resource.data.farmerId ||
                            request.auth.uid == request.resource.data.farmerId;
    }

    match /livestockListings/{listingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /cattle/{cattleId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 4. Buyer & Farmer Orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if !isAuthenticated() ||
                    request.auth.uid == resource.data.buyerId ||
                    request.auth.uid == resource.data.farmerId;
      allow delete: if false; // Preserved audit records

      match /items/{itemId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }
    }

    // 5. Bulk Orders (Wholesale supply requests)
    match /bulkOrders/{bulkOrderId} {
      allow read: if true;
      allow create: if true;
      allow update: if !isAuthenticated() ||
                    request.auth.uid == resource.data.buyerId ||
                    request.auth.uid == resource.data.farmerId;
      allow delete: if false;
    }

    // 6. Reviews & Ratings
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if !isAuthenticated() || request.auth.uid == resource.data.buyerId;
    }

    // 7. Export Listings & Requests
    match /exportListings/{exportId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /exportRequests/{exportId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 8. Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // 9. Community Discussions
    match /community_posts/{postId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // 10. Mandi & Market Rates
    match /market_rates/{rateId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
